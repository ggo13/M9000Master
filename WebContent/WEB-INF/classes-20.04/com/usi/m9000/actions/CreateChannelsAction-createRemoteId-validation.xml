<!DOCTYPE validators PUBLIC "-//Apache Struts//XWork Validator 1.0.3//EN"
        "http://struts.apache.org/dtds/xwork-validator-1.0.3.dtd">
<validators>
	<field name="stationDetails.systemStationId">
		<field-validator type="conversion" short-circuit="true">
			<param name="repopulateField">true</param>
			<message key="errors.number" />
		</field-validator>
		<field-validator type="regex" short-circuit="true">
			<param name="expression">^[0-9]+$</param>
			<message key="errors.number" />
		</field-validator>
		<field-validator type="int">
			<param name="min">0</param>
			<param name="max">1000000</param>
			<message key="errors.range" />
		</field-validator>
		<field-validator type="required" short-circuit="true">
			<message key="errors.required" />
		</field-validator>
	</field>
	<field name="stationDetails.systemStationName">
		<field-validator type="requiredstring" short-circuit="true">
			<param name="trim">true</param>
			<message key="errors.required" />
		</field-validator>
	</field>
	<field name="stationDetails.systemAnalogChannelsCount">
		<field-validator type="conversion" short-circuit="true">
			<param name="repopulateField">true</param>
			<message key="errors.number" />
		</field-validator>
		<field-validator type="regex" short-circuit="true">
			<param name="expression">^[0-9]+$</param>
			<message key="errors.number" />
		</field-validator>
		<field-validator type="required" short-circuit="true">
			<message key="errors.required" />
		</field-validator>
	</field>
	<field name="stationDetails.systemDigitalChannelsCount">
		<field-validator type="conversion" short-circuit="true">
			<param name="repopulateField">true</param>
			<message key="errors.number" />
		</field-validator>
		<field-validator type="regex" short-circuit="true">
			<param name="expression">^[0-9]+$</param>
			<message key="errors.number" />
		</field-validator>
		<field-validator type="required" short-circuit="true">
			<message key="errors.required" />
		</field-validator>
	</field>
