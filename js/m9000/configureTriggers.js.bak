function isAllDAlarmChecked() {
	var form = document.forms["triggerChannels"];
	console.log("Checked ddrchk boxes: " + $("input[type='checkbox'][name$='disturbanceAlarm']:not(:disabled):checked").length);
	console.log("Total ddrAlarms:" + $("input[type='checkbox'][name$='disturbanceAlarm']:not(:disabled)").length);

	if ($("input[type='checkbox'][name$='disturbanceAlarm']:not(:disabled)").length > 0 
		&& ($("input[type='checkbox'][name$='disturbanceAlarm']:not(:disabled):checked").length == $("input[type='checkbox'][name$='disturbanceAlarm']:not(:disabled)").length)) {
		form.elements["dAlarmCheckUncheck"].checked = true;
	}
	else {
		form.elements["dAlarmCheckUncheck"].checked = false;
	}

}
		
