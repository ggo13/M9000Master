function uncheckAllDAlarms() {
	var form = document.forms["triggerChannels"];
	var i = 0;
	var objPrefix = 'lstTriggerChannels[' + i + '].';
	var objName = objPrefix + "channel";

	while (form.elements[objName] != null) {
		//				if (form.elements[objName].disabled == false  && form.elements[objPrefix+"pmuStatus"].checked == false)
		if (form.elements[objName].disabled == false) {
			objName = objPrefix + "disturbanceAlarm";
			form.elements[objName].checked = false;
			//					objName = objPrefix+"exportRate";
			//					form.elements[objName].disabled = true;
		}
		i = i + 1;
		objPrefix = 'lstTriggerChannels[' + i + '].';
		objName = objPrefix + "channel";
	}
}
function updateNewAlgorithms(){
			var i = totalMeasurementsCount;
			var form = document.forms["triggerChannels"];
			var objPrefix = 'lstTriggerChannels['+ i +'].';
			var objName = objPrefix+"channel";

/*			while (form.elements[objName] != null)
			{
					update_access(form.elements[objName], form.elements[objPrefix+"type"].value);
			   i++;
			   objPrefix = 'lstTriggerChannels['+ i +'].';
			   objName = objPrefix+"channel";
			}
*/			
	// Loop through the newly added measurements and update the correspoding access
	$("#measurementTable tr[id^='tr_']").slice(totalMeasurementsCount).each(function() {
		var channelElementName = $(this).find("[id$='channel']").attr("name");
		var algorithmValue = $(this).find("[id$='type']").val();
		update_access(channelElementName, algorithmValue);
	});

		}
function deleteMeasurement(measurementToDelete, rowIdToDelete) {
            console.log("measurementToDelete "+measurementToDelete.id+" rowIdToDelete "+rowIdToDelete);
            if (confirm('Virtual Measurements and Fault location logic might be affected by these deleted measurements. Are you sure you want to delete?')) {
                $.ajax({
                    type: 'POST',
                    url: 'deleteMeasurementAction',
                    contentType: 'application/json',  // Sending JSON
                    data: JSON.stringify({measurementToDelete: measurementToDelete}) ,
                    success: function(response) {
                        console.log('Response from server:', response);
                        $('#tr_' + rowIdToDelete).remove();  // Remove the row from the table
                        checkForReinit();
                    },
            error: function(jqXHR, textStatus, errorThrown) {
                console.error('Error:', textStatus, errorThrown);
                alert("Error deleting.");
            }
                        });
            }
        }
        
function checkForReinit() {
	 let values = [];
	$('[id$="id"]').each(function() {
		let value = parseInt($(this).val(), 10); // Parse value as integer
		if (!isNaN(value)) {
			values.push(value);
		}
	});

	// Step 2: Sort the values and check for discontinuity
	values.sort((a, b) => a - b); // Sort numerically
	let discontinuous = false;
	if (values[0] != 1) {
		discontinuous = true;
	} else {
		for (let i = 1; i < values.length; i++) {
			if (values[i] !== values[i - 1] + 1) { // Check if current value is exactly one more than previous
				discontinuous = true;
				break;
			}
		}
	}

	// Step 3: Output result
	if (discontinuous) {
		$('#btnReinit').show();
	} else {
		$('#btnReinit').hide();
	}
}
