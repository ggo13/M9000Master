var lastSelectedRow = null;
$(document).ready(function() {
	isAllMeasurementsEnabled();
	isAllExportsChecked();
	isAllPmuChecked();
	isAllDdrsChecked();
	isAllDAlarmChecked();
	hideAssistance();
	checkForReinit();
	$('#enableAssist').show();
	$('#buttonsTop').show();
	$('#buttonsBottom').show();
	if (!isDfrAddedOrRemoved) {
		$('#navMenu').show();
	}
	setFocus();

	enableShiftSelectCheckboxes();
	handleDurationInput();
	highlightSelectedRows();
	
	// Validate the new measurement form
	$.validator.addMethod("numericOnly", function(value, element) {
        return this.optional(element) || /^\d+$/.test(value);
    }, "Please enter only numeric digits (0-9).");
    
       $.validator.addMethod("range1to100", function(value, element) {
        let number = parseInt(value, 10);
        return this.optional(element) || (!isNaN(number) && number >= 1 && number <= 100);
    }, "Please enter a number between 1 and 100.");
    
    
    $("#newMeasurementsForm").validate({
            rules: {
                newMeasurementsCount: {
                    required: true,
                    numericOnly: true,
                    range1to100: true  // Apply custom rule
                }
            },
            messages: {
                newMeasurementsCount: {
                    required: "Please enter the number of measurements.",
                    numericOnly: "Please enter a valid number.",
                    range1to100: "Please enter a number between 1 and 100."
                }
            },
        errorPlacement: function(error, element) {
            error.appendTo("#formErrors"); // All errors go to a single container
        }
         });
	$("#newMeasurementsCount").on("keyup change", function() {
    	$("#btnAddNewMeasurements").prop("disabled", !$("#newMeasurementsForm").valid());
    	if ($("#newMeasurementsForm").valid())
        {
                $("#btnAddNewMeasurements").css({ opacity: 1, pointerEvents: "auto" });
        }
        else
        {
                $("#btnAddNewMeasurements").css({ opacity: 0.5, pointerEvents: "none" });
        }
	});
	$('[id$="AddMeasurements"]').click(function(e) {
		e.preventDefault();
		$('#newMeasurementsDialog').dialog('close');
		$.ajax({
			type: "POST",
			url: "/M9000Master/triggerChannelsAddMeasurements.action",
			data: $("#triggerChannels").serialize(),
			success: function(data, status, request) {
				// alert("On click event "+data);
				$('#measurementTable tbody').append(data);
				enableShiftSelectCheckboxes();
				handleDurationInput();
				highlightSelectedRows();
				var form = document.forms["triggerChannels"];
				if (form.elements['enableAssist'].checked) {
					showAssistance();
				}
				else {
					hideAssistance();
				}
				$('#AddMeasurement').focus();

			},
			error: function(data, status, request) {
				alert("Issues!" + data);
			}
		});
	});

	$('#triggerChannels').submit(function(e) {
		$("#triggerChannels :disabled").removeAttr('disabled');
	});
	$("body").css("cursor", "default");
	$(".traverseMenu").css('cursor', 'pointer');
	if (userRole != 'admin') {
		$("#triggerChannels :input").prop("disabled", true);
	}

	$("table.configureTable tr[id^=tr_]").bind("paste", function(e) {
		var clipboardText = e.originalEvent.clipboardData.getData("text/plain");;
		if (clipboardText.split(/\r\n|\r|\n/).length > 1) {
			e.stopPropagation();
			e.preventDefault();
			handlePasteEvent(e);
		}
	});

	$("#checkUncheck").click(function() {
		var checkBoxes = $("input[type='checkbox'][name$='exportStatus']:not(:disabled)");
		checkBoxes.prop("checked", this.checked).trigger("change");
	});

//	Check or uncheck all checkboxes
	$("#ddrCheckUncheck").click(function() {
		var checkBoxes = $("input[type='checkbox'][name$='ddrStatus']:not(:disabled)");
		checkBoxes.prop("checked", this.checked);
	});

	$("#dAlarmCheckUncheck").click(function() {
		var checkBoxes = $("input[type='checkbox'][name$='disturbanceAlarm']:not(:disabled)");
		checkBoxes.prop("checked", this.checked);
	});

	$('input[type="checkbox"][name$="exportStatus"]:not(:disabled)').on('change', function() {
		changeExportState(this, this.checked)
	});
    var fewqPmuStatusChkBoxes = $('[id^="lst"][id$="freqPmuStatus"]');
    fewqPmuStatusChkBoxes.click(function()
    {
            $("*").css("cursor", "progress");
            if (this.checked)
            {
                    fewqPmuStatusChkBoxes.not(this).attr("checked", !this.checked);
                    fewqPmuStatusChkBoxes.not(this).attr("disabled", this.checked);
            }
            else
            {
                    fewqPmuStatusChkBoxes.each(function() {
                            var obj = $(this).attr("id");
                            var objPrefix = obj.substring(0, obj.indexOf('.')+1);
            //              console.log("object" + objPrefix+"type");
            //              console.log($(jqSelector(objPrefix+"type")).val()+ " ? "+($(jqSelector(objPrefix+"type")).val() != 'Frequency'));
                            if ($(jqSelector(objPrefix+"type")).val() != 'Frequency')
                            {
                                    $(jqSelector(objPrefix+"freqPmuStatus")).attr("disabled", true);
                            }
                            else
                            {
                                    $(jqSelector(objPrefix+"freqPmuStatus")).attr("disabled", false);
                            }
                    });
            }
            $("*").css("cursor", "default");
    });	

  $.subscribe('cancelMeasurementsTopic', function(event, data) {
		event.preventDefault();
		console.log("Cancel New Measurements dialog ");
		$('#newMeasurementsDialog').dialog('close');
		$('#btnBottomNext').focus();
	});

    $.subscribe('newMeasurementsTopic', function(event, data) {
		console.log("New Measurements success topic here!!",data);
		var newContent = $('#dummyTarget').html();

		// Append the content to the table body
		$('#measurementBody').append(newContent);

		// Optionally, remove the dummy target after appending
		$('#dummyTarget').empty();

			enableShiftSelectCheckboxes();
				handleDurationInput();
				highlightSelectedRows();
				updateNewAlgorithms();
				console.log("Total measurements count: "+(($('#measurementBody tr').length)-1));
				$('#totalMeasurementsCount').val(($('#measurementBody tr').length)-1);
				totalMeasurementsCount = ($('#measurementBody tr').length)-1;
				var form = document.forms["triggerChannels"];
				if (form.elements['enableAssist'].checked) {
					showAssistance();
				}
				else {
					hideAssistance();
				}
			//$('#newMeasurementsDialog').dialog('close');
				$('#btnAddMeasurement').focus();
			var target = $('#btnAddMeasurement');
			$("#newMeasurementsDialog").dialog("option", "position", {
				my: "center bottom",
				at: "center bottom-10",
				of: target
			});
			$("#successMsg").text("Successfully added "+$("#newMeasurementsCount").val() + " " + $("#newMeasurementsType").val()+" measurement(s)");	
		$("#successMsg")	
                .css("background-color", "yellow") // Initial highlight color
                .animate({ backgroundColor: "#9999CC" }, 5000);

			$("#newMeasurementsDialog").focus();
				//$('#btnAddMeasurement').focus();
		});
	$.subscribe('newMeasurementsErrorTopic', function(event, data) {
			$('#newMeasurementsDialog').dialog('close');
			$('#userMsgError').val(data);
			$('#userMsgError').focus();
		});
		
		// Show busy cursor when form is being processed
$.subscribe('showBusyCursor', function() {
    $('body').css('cursor', 'wait');  // Set busy cursor
});

// Hide busy cursor when processing is done (success or error)
$.subscribe('hideBusyCursor', function() {
    $('body').css('cursor', 'auto');  // Reset cursor back to normal
});

$('#btnReinit').click(function() {
                if (confirm('Are you sure you want to reinitialize all measurement ids?')) {
	                $('#booReorderMeasurementIds').val(true);
	                $("#triggerChannels :disabled").removeAttr('disabled');
	                // Submit the form
	                $('#triggerChannels').submit();
	                }
            });
            
	$('#deleteSelected').click(function() {
		if (confirm("Virtual Measurements and Fault location logic might be affected by these deleted measurements. Are you sure you want to delete selected measurements?")) {
			// Collect data for all selected entities
			let selectedMeasurementsToDelete = [];

			$('input[type="checkbox"][id^="globalSelect_"]:checked').each(function() {
				let row = $(this).closest('tr'); // Get the parent row
				console.log("row " + row);
				let id = row.find('label[id$="id"]').text();
				console.log("id " + id);
				let type = row.find('[id$="type"]').val();
				let chassis = row.find('[id$="chassis"]').val();
				let inputChannelName = row.find('[id$="inputChannelName"]').val();
				let measurementName = id + ' - ' + inputChannelName;
				// Store the entity details in an object
				let entity = {
					id: id,
					type: type,
					chassis: chassis,
					measurementName: measurementName
				};
				selectedMeasurementsToDelete.push(entity); // Add entity object to the array
			});

			if (selectedMeasurementsToDelete.length === 0) {
				alert("Please select at least one entity to delete.");
				return;
			}

			console.log("Selected entities to delete:", selectedMeasurementsToDelete); // For debugging

			// Perform an AJAX call to send selected entities data to the delete action
			$.ajax({
				url: 'deleteSelectedMeasurementsAction', // Replace with the URL for your delete action
				type: 'POST',
				data: JSON.stringify({ selectedMeasurementsToDelete: selectedMeasurementsToDelete }),
				contentType: 'application/json',
				success: function(response) {
					// On successful deletion, remove deleted rows from the table
					$('input[type="checkbox"][id^="globalSelect_"]:checked').closest('tr').remove();
				},
				error: function(xhr, status, error) {
					console.error("Error deleting entities:", error);
					alert("An error occurred while deleting the selected entities.");
				}
			});
		}
	});
     
	$(window).on("scroll resize", function() {
		if ($("#myDialog").data("ui-dialog")) {
		if ($("#newMeasurementsDialog").dialog("isOpen")) {
			var target = $('#btnAddMeasurement');
			$("#newMeasurementsDialog").dialog("option", "position", {
				my: "center bottom",
				at: "center bottom-10",
				of: target
			});
			console.log("Focussing on dialog now");
			$("#newMeasurementsDialog").focus();
		}
		else {
			console.log("Dialog is not open");
		}
		}
	});
  
        
});

